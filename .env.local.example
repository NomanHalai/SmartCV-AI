# Anthropic API Key — get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=your_api_key_here

# App URL (used for metadata)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Firebase client config — Firebase Console > Project settings > Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin config — derive from your service account JSON.
# Do not commit the service account JSON file.
project_id=
client_email=
private_key=
database_id=smartcvai
